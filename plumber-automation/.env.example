# ---------------------------------------------------------------------------
# Copy to .env and edit:   cp .env.example .env
# The defaults below run the entire automation with NO paid accounts.
# ---------------------------------------------------------------------------

# THE MASTER SWITCH.
# true  -> every external call goes to the local mock server. Free. Nothing real
#          is sent to anyone. This is how you develop and demo.
# false -> real APIs. Real texts to real phones, real invoices. Only flip this
#          after reading docs/GOING-LIVE.md.
MOCK_MODE=true
MOCK_BASE_URL=http://mock:4000

# --- Business identity (shows up in every message) --------------------------
BUSINESS_NAME=Rapid Response Plumbing
BUSINESS_PHONE=+15125550100
BUSINESS_EMAIL=dispatch@example-plumbing.com
BUSINESS_TIMEZONE=America/Chicago
BOOKING_URL=http://localhost:8080/booking.html
GOOGLE_REVIEW_URL=https://g.page/r/EXAMPLE/review

# Never text a customer between these hours (local time, 24h clock).
# Most US states restrict marketing/automated SMS outside 8am-9pm.
QUIET_HOURS_START=21
QUIET_HOURS_END=8

# --- Infrastructure ---------------------------------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_local_dev
POSTGRES_DB=plumber
WEBHOOK_URL=http://localhost:5678/

# ===========================================================================
# LIVE CREDENTIALS — all ignored while MOCK_MODE=true. Leave blank for now.
# ===========================================================================

# --- GoHighLevel (CRM) ------------------------------------------------------
# Private Integration token, from Settings -> Private Integrations.
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_STAGE_BOOKED_ID=
GHL_STAGE_CONFIRMED_ID=
GHL_STAGE_COMPLETED_ID=

# --- Twilio (SMS) -----------------------------------------------------------
# NOTE: US SMS also requires A2P 10DLC registration. See docs/COMPLIANCE.md.
# Skipping it gets your texts silently filtered by the carriers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email ------------------------------------------------------------------
# Either a provider API key, or plain SMTP. Mock mode needs neither.
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Google Maps (route optimization + arrival ETA) -------------------------
# Enable "Routes API" and "Geocoding API" in Google Cloud Console.
# Has a generous free tier; a small plumber will likely never pay.
GOOGLE_MAPS_API_KEY=

# --- Claude (writes the post-job report) ------------------------------------
# console.anthropic.com -> API keys. A report costs well under a cent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- QuickBooks Online (invoicing) ------------------------------------------
# OAuth2. The refresh token is obtained once via the Intuit OAuth playground.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
QBO_ENVIRONMENT=sandbox
